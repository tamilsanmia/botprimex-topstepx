{
  // Freqtrade on ProjectX (TopstepX). Copy to user_data/config.json.
  // Credentials are NOT in this file: put them in .env (see .env.example).
  "bot_name": "botprimex-topstepx",
  "db_url": "sqlite:////freqtrade/user_data/tradesv3.sqlite",
  "max_open_trades": 4,
  "stake_currency": "USD",
  "stake_amount": "unlimited",
  "tradable_balance_ratio": 1,
  "dry_run": true,
  "dry_run_wallet": 50000,
  "fiat_display_currency": "USD",
  "timeframe": "5m",
  "trading_mode": "futures",
  "margin_mode": "isolated",
  "cancel_open_orders_on_exit": false,
  "unfilledtimeout": { "unit": "minutes", "enter": 2, "exit": 2 },
  "order_types": {
    "entry": "market",
    "exit": "market",
    "emergency_exit": "market",
    "force_entry": "market",
    "force_exit": "market",
    "stoploss": "market",
    "stoploss_on_exchange": true,
    "stoploss_on_exchange_interval": 5
  },
  // Level 1 data only on TopstepX: no order book pricing.
  "entry_pricing": { "price_side": "other", "use_order_book": false, "price_last_balance": 0.0,
                     "check_depth_of_market": { "enabled": false, "bids_to_ask_delta": 1 } },
  "exit_pricing": { "price_side": "other", "use_order_book": false, "price_last_balance": 0.0 },
  "exchange": {
    "name": "projectx",
    "key": "",
    "secret": "",
    // Live candles over the gateway websocket (ccxt.pro watch_ohlcv).
    "enable_ws": true,
    // Freqtrade's native order flow from the gateway's tick recorder.
    // Leave false until a few sessions of ticks are recorded, then enable.
    "use_public_trades": false,
    "ccxt_config": {
      "options": { "gatewayUrl": "http://projectx-gateway:8787", "maxLeverage": 50, "maxOrderSize": 50 }
    },
    "ccxt_async_config": {},
    // TopstepX contracts, as ROOT/USD:USD. Each root follows the current front month.
    // Holding a mini and its micro together (ES + MES, NQ + MNQ, CL + MCL ...) is blocked
    // by topstep.lots.block_mini_micro_overlap, so listing both lets the first signal pick.
    // Also available: NKD, PL, HO, RB, MNG, NG, QG, QM, SI, HG,
    //   FX 6A 6B 6C 6E 6J 6M 6N 6S E7 M6A M6B M6E,
    //   rates ZT ZF ZN TN ZB UB, ags ZC ZS ZW ZL ZM HE LE (shorter sessions).
    "pair_whitelist": [
      "MES/USD:USD", "ES/USD:USD",
      "MNQ/USD:USD", "NQ/USD:USD",
      "M2K/USD:USD", "RTY/USD:USD",
      "MYM/USD:USD", "YM/USD:USD",
      "MGC/USD:USD", "GC/USD:USD",
      "SIL/USD:USD", "MHG/USD:USD",
      "MCL/USD:USD", "CL/USD:USD",
      "MBT/USD:USD", "MET/USD:USD"
    ],
    "pair_blacklist": []
  },
  "pairlists": [{ "method": "StaticPairList" }],
  "internals": { "process_throttle_secs": 1 },

  // Freqtrade native order flow settings (used when exchange.use_public_trades is true).
  // scale = price bin: 0.25 for ES/MES/NQ/MNQ, 0.1 for GC/MGC, 0.01 for CL/MCL.
  "orderflow": { "cache_size": 1000, "max_candles": 500, "scale": 0.25,
                 "stacked_imbalance_range": 3, "imbalance_volume": 1, "imbalance_ratio": 3 },

  "projectx_gateway": {
    // "auto" picks the only tradeable account; with several, set the id or name.
    "account": "auto",
    // Must match the account's data subscription or the contract list is empty.
    "live_data": false,
    // How long a market order waits for its fill event before returning.
    "fill_wait_ms": 1500,
    // "separate": Freqtrade's own stop order. "native": also attach a stopLossBracket
    // sized to max_risk_per_trade (account must be in Auto OCO Brackets mode).
    "brackets": "separate",
    // Who makes sure an open position has a stop (watched every 2 s, needs topstep.protection.max_risk_per_trade):
    //   "gateway": Freqtrade's own stop (stoploss_on_exchange) is the normal path. If a position still has no
    //              working stop after grace_secs the gateway places one at max_risk_per_trade distance, and
    //              flattens the position when it cannot, or when none is working after flatten_after_secs.
    //              Entries the gateway could not protect (risk under one tick for the size, unknown tick
    //              value, user hub down) are refused.
    //   "native":  attach a stopLossBracket to every entry, nothing else (as brackets "native").
    //   "off":     no gateway stop and no flatten.
    "protective_stop": { "mode": "gateway", "grace_secs": 10, "flatten_after_secs": 30 },
    "reconcile_secs": 30,
    "flatten_grace_secs": 30,
    "backfill_candles": 1500,
    "max_candles": 5000,
    "max_order_size": 50,
    // "auto": dry-run -> guard runs on Freqtrade's simulated trades; live -> ProjectX account.
    "account_source": "auto",
    // "auto": adds the account size to the $0-start balance of an Express Funded or a Topstep
    // Labs account (e.g. 6KCHCR-LABS... -> +6000) for sizing. A number sets the offset; 0 turns it off.
    "balance_offset": "auto",
    // order_reserve: of the "other" window, the last N requests are kept for orders, so reads
    // and background syncs cannot starve a stop or an exit. max_queue bounds waiting
    // non-order requests: the oldest background one is dropped first, then new reads fail.
    "rate_limits": { "bars_per_30s": 40, "other_per_60s": 180, "order_reserve": 20, "max_queue": 500 },
    // Stale data protection. A market quote (per whitelisted pair), a hub or the REST
    // reconcile that has been silent for block_entries_secs blocks new entries; with a
    // position open, flatten_secs flattens it through REST (0 = never flatten). Quote
    // staleness is ignored on weekends and from flat_by until the session reset.
    // notify sends a Telegram message when data goes stale and when it recovers.
    "stale": { "block_entries_secs": 15, "flatten_secs": 120, "notify": true },
    // How long the gateway keeps finished orders and fills in memory. The guard rebuilds
    // missed end-of-day history from 90 days of fills at start-up, before anything is pruned.
    "user_retention": { "orders_days": 2, "trades_days": 14 },
    "ticks": { "record": true, "retention_days": 30, "pairs": "whitelist" },
    "orderflow": { "block_multiple": 25, "value_area_pct": 70 }
  },

  "topstep": {
    // false disables every Topstep rule and protection (not recommended).
    "enabled": true,
    // false: dry-run trades with every Topstep rule and protection off; live trading keeps them.
    "dry_run_enabled": true,
    // "auto" reads phase and size from the account name: 50KTC -> evaluation 50K,
    // XFA -> funded (starts at $0), LFA -> live_funded. A Topstep Labs account (6KCHCR-LABS...)
    // starts at $0 but has no rule presets: set phase and the limits under "phases" yourself.
    "phase": "auto",
    "preset": "auto",
    "start_balance": "auto",
    // Dry-run only: the account to simulate when phase/preset are "auto", for example "50KTC-DRY",
    // "100KXFA-1" or "150KLFA-1" (size + TC, XFA or LFA). It wins over an auto-detected account and
    // is ignored on a live account, which always supplies its own name. Backtests read it too.
    // "account_name": "50KTC-DRY",
    "timezone": "America/New_York",
    "session": {
      "reset_time": "18:00", "eod_time": "16:10",
      "no_entry_before": "18:05", "no_entry_after": "15:45", "flat_by": "16:05",
      "hold_mode": "intraday",
      "trading_windows": [],
      "trade_weekends": false,
      // CME holidays and early closes for 2026-2027 (src/holidays.js, see docs/topstep-rules-sources.md):
      // a closed day acts like a weekend, an early close stops entries 35 min and flattens 20 min before
      // the halt (13:00 ET, Topstep closes positions 15 min before). false ignores the calendar.
      "use_holiday_calendar": true,
      "news_blackout": [{ "days": "mon-fri", "start": "08:28", "end": "08:35", "label": "8:30 data" }]
    },
    "lots": { "micro_ratio": 10, "block_mini_micro_overlap": true, "overrides": {} },
    // null = take the value from the preset for the account size. Set a number to override.
    "phases": {
      "evaluation": {
        "profit_target": null, "daily_loss_limit": null, "max_loss_limit": null,
        "max_loss_type": "trailing_eod", "daily_loss_type": "intraday", "mll_lock_balance": null,
        // consistency_pct: Topstep's consistency target, 55 (0 = off).
        // consistency_mode: "cap_day" (default, cautious) stops entries for the day at pct x profit_target
        // ($1,650 on 50K) so the target never rises; "raise_target" is Topstep's own rule (no cap, the
        // profit target rises to best day / pct); "off" ignores consistency.
        "session": {}, "consistency_pct": 55, "consistency_mode": "cap_day",
        "max_mini_equivalent": null, "stop_on_target": true
      },
      "funded": {
        "profit_target": null, "daily_loss_limit": null, "max_loss_limit": null,
        "max_loss_type": "trailing_eod", "daily_loss_type": "intraday", "mll_lock_balance": 0,
        "session": {}, "consistency_pct": null,
        "scaling_plan": null,
        "payout": { "min_winning_days": 5, "min_winning_day_amount": 150 }
      }
    },
    // max_trades_per_day, max_consecutive_losses, max_risk_per_trade: 0 turns them off.
    "protection": {
      "dll_soft_pct": 70, "dll_hard_pct": 90, "mll_buffer": 300,
      "max_risk_per_trade": 250, "max_trades_per_day": 10, "max_consecutive_losses": 3,
      "daily_profit_lock": { "enabled": true, "activate_at": 800, "giveback_pct": 40 }
    }
  },

  // BotPrimeX_TopstepX strategy settings.
  "topstep_strategy": {
    // Protective stop distance: ATR(period) x mult, clamped to [min, max] ticks.
    // Contracts per trade = floor(max_risk_per_trade / (stop ticks x tick value)).
    "stop_atr_period": 14,
    "stop_atr_mult": 2.0,
    "min_stop_ticks": 8,
    "max_stop_ticks": 400,
    "max_contracts_per_trade": 10,
    "partial_exit_min_contracts": 2,
    "roll_guard_days": 2,
    "leverage": 50,
    "notify_guard_changes": true,
    // Live and dry-run: a stop is never placed at, through or within this many ticks of the
    // market (it would fill on placement). Backtests ignore it. 0 turns it off.
    "stop_min_distance_ticks": 4,
    // Experimental 1s-30s strategy timeframes.
    "seconds_mode": { "startup_candle_count": 300, "protection_minutes": 5 }
    // NoTankAi_TopstepX only: optional signal DCA (see NoTankAI_TopstepX.py). dca_stop "strategy"
    // puts the stop after an add at the strategy stoploss from the new average entry
    // (stoploss -0.1 at leverage 50 = 0.2% of price) and sizes the add so the whole position's
    // loss to it stays within max_risk_per_trade; "atr" puts it stop_atr_mult x ATR from the
    // add's fill price. To use it, add a comma after seconds_mode and uncomment:
    // "signal_dca": { "enabled": false, "first_contracts": 1, "max_adds": 2, "only_in_loss": true,
    //                 "target_points": null, "target_atr_mult": 1.0, "dca_stop": "strategy" }
  },
  "topstep_orderflow": {
    "enabled": false,
    "confirm_delta_candles": 3,
    "block_against_stacked_imbalance": true,
    "cvd_divergence_exit": false,
    "cvd_divergence_lookback": 20
  },

  // Trading costs per contract and per side, charged in backtest, hyperopt and dry-run. Live trading
  // ignores this block: its fills carry the real fees. Defaults mirror the mock gateway (mock.js).
  // The costs are set on each trade's fee_open/fee_close, so Freqtrade's "fee" setting is not needed.
  "topstep_costs": {
    "enabled": true,
    "fee_per_contract": 0.37,
    "commission_per_contract": 0.25,
    "slippage_ticks": 1
  },
  "telegram": {
    "enabled": false,
    "token": "",
    "chat_id": "",
    "allow_custom_messages": true,
    "notification_settings": {
      "status": "silent", "warning": "on", "startup": "off", "entry": "silent", "entry_fill": "on",
      "entry_cancel": "silent",
      "exit": { "roi": "silent", "emergency_exit": "on", "force_exit": "on", "exit_signal": "silent",
                "trailing_stop_loss": "on", "stop_loss": "on", "stoploss_on_exchange": "on",
                "custom_exit": "on", "partial_exit": "on" },
      "exit_cancel": "on", "exit_fill": "on", "protection_trigger": "off",
      "protection_trigger_global": "on", "strategy_msg": "on", "show_candle": "off"
    },
    "reload": true,
    "balance_dust_level": 0.01
  },
  // 0.0.0.0 is the address inside the container; compose publishes the port on 127.0.0.1 by default.
  // jwt_secret_key, ws_token and password must be real secrets: the live bot refuses to start
  // while one of them is empty or still contains "change-me".
  "api_server": {
    "enabled": true,
    "listen_ip_address": "0.0.0.0",
    "listen_port": 8080,
    "verbosity": "error",
    "enable_openapi": false,
    "jwt_secret_key": "change-me-to-a-long-random-string",
    "ws_token": "change-me",
    "CORS_origins": [],
    "username": "admin",
    "password": "change-me"
  },
  "initial_state": "running",
  "force_entry_enable": false
}
