# The base is pinned by version tag AND digest, so a rebuild cannot silently pick up
# a different Freqtrade. The two patches below depend on Freqtrade's internals. To
# upgrade: pull the new tag, check `docker image inspect <tag> --format
# '{{index .RepoDigests 0}}'`, change both ARGs, build with a :fixcheck tag, run the tests.
ARG FREQTRADE_VERSION=2026.9
ARG FREQTRADE_DIGEST=sha256:989aff5636d8f0213ed44fe334c3314a194a51c0c755d16866960247aafd2eae
FROM freqtradeorg/freqtrade:${FREQTRADE_VERSION}@${FREQTRADE_DIGEST}
ARG FREQTRADE_VERSION
# required: the build fails when the FreqUI timeframe list is not found (a FreqUI
# change). optional: warn and build without the seconds timeframes in the UI.
ARG FREQUI_PATCH=required
# The projectx package registers the "projectx" exchange with ccxt and provides
# Freqtrade's Projectx exchange class. Exporting it from freqtrade.exchange is all
# ExchangeResolver needs; Freqtrade itself is not modified otherwise.
COPY --chown=ftuser:ftuser projectx /opt/projectx/projectx
ENV PYTHONPATH=/opt/projectx
USER root
# Idempotent: appended once, the final import check below proves it works.
RUN init=/freqtrade/freqtrade/exchange/__init__.py \
 && test -f "$init" \
 && if grep -q 'projectx.ft_exchange' "$init"; then echo "exchange/__init__.py already imports projectx"; \
    else printf '\n# ProjectX (TopstepX) via projectx-gateway\ntry:\n    from projectx.ft_exchange import Projectx  # noqa: E402,F401\nexcept ImportError:\n    pass  # projectx.ft_exchange imported first; it registers itself when done\n' >> "$init"; fi
# FreqUI's timeframe dropdowns are a fixed list starting at 1m. Add the seconds
# timeframes the gateway streams. A missing pattern fails the build unless
# --build-arg FREQUI_PATCH=optional.
RUN ui=$(python -c "import freqtrade,os;print(os.path.dirname(freqtrade.__file__))")/rpc/api_server/ui/installed/assets \
 && files=$(grep -l '{value:`1m`,label:`1m`}' "$ui"/*.js 2>/dev/null || true) \
 && if [ -n "$files" ]; then \
      sed -i 's/{value:`1m`,label:`1m`}/{value:`1s`,label:`1s`},{value:`5s`,label:`5s`},{value:`10s`,label:`10s`},{value:`15s`,label:`15s`},{value:`30s`,label:`30s`},{value:`1m`,label:`1m`}/' $files \
      && grep -q '{value:`5s`,label:`5s`}' $files \
      && echo "FreqUI: seconds timeframes added to $files"; \
    elif [ "$FREQUI_PATCH" = "optional" ]; then \
      echo "WARNING: FreqUI timeframe list not found; seconds timeframes not added to the UI"; \
    else \
      echo "ERROR: FreqUI timeframe list not found in $ui (FreqUI changed?). Fix the patch or build with --build-arg FREQUI_PATCH=optional" >&2; exit 1; \
    fi
# Content hash of the baked-in package; ./topstep start compares it with the working tree.
RUN find /opt/projectx/projectx -name '*.py' | LC_ALL=C sort | xargs cat | sha256sum | cut -d' ' -f1 > /opt/projectx/BUILD_HASH \
 && cat /opt/projectx/BUILD_HASH
USER ftuser
RUN freqtrade --version | grep -Eq "freqtrade ${FREQTRADE_VERSION}\$" \
 && python -c "import freqtrade.exchange as e, ccxt; assert e.Projectx and 'projectx' in ccxt.exchanges"
