# Copy to .env and fill in. Never commit .env.

# TopstepX login username (not your email) and an API key from
# https://topstepx.com/settings?tab=api
PROJECTX_USERNAME=
PROJECTX_API_KEY=

# Which trading account this bot uses (one account per bot). List them with:
#   docker compose run --rm --no-deps projectx-gateway node src/accounts.js
# Empty = "auto": only works while exactly one account can trade.
PROJECTX_ACCOUNT_ID=

# Strategy for the live / dry-run bot: BotPrimeX_TopstepX or NoTankAi_TopstepX
STRATEGY=BotPrimeX_TopstepX

# Shared secret between Freqtrade and the gateway (any long random string), e.g.
#   openssl rand -hex 32
# The gateway refuses to start with an empty secret (only PROJECTX_MOCK=1 may).
GATEWAY_SECRET=
# Address the gateway listens on. 0.0.0.0 is needed so the Freqtrade container can reach it.
# GATEWAY_BIND=0.0.0.0
# Optional IPv4 CIDR of the internal Docker network: the gateway then listens only on its
# interface inside that subnet and refuses to start if there is none, e.g. 172.20.0.0/16.
# Note the container HEALTHCHECK probes 127.0.0.1, so it will fail while this is set.
# GATEWAY_BIND_SUBNET=
# Accept the secret as /ws?secret=... too. Off by default: URLs end up in logs.
# GATEWAY_ALLOW_QUERY_SECRET=1
# Market data only: order routes answer 403 and no account, user hub or guard is started.
# For the backtesting gateway; never set it on the stack that trades.
# GATEWAY_DATA_ONLY=1

# Backtesting web app (docker-compose-webserver.yml). It listens on 127.0.0.1 by default
# (private: reach it with an SSH tunnel, ssh -L 8095:127.0.0.1:8095 <user>@<server>, or
# behind a TLS reverse proxy). Set WEBSERVER_BIND=0.0.0.0 only if you accept the exposure.
# The api_server password, jwt_secret_key and ws_token in config-futures-backtest.json
# (and in config.json for the live bot) must be real secrets, not "change-me".
# WEBSERVER_PORT=8095
# WEBSERVER_BIND=127.0.0.1

# Optional overrides (defaults are the TopstepX endpoints)
# PROJECTX_API_BASE=https://api.topstepx.com
# PROJECTX_MARKET_HUB=https://rtc.topstepx.com/hubs/market
# PROJECTX_USER_HUB=https://rtc.topstepx.com/hubs/user

# Testing only: synthetic prices and fills, no ProjectX connection at all.
# PROJECTX_MOCK=1
